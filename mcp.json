{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "serena-agent@1.7.0",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd"
      ],
      "requestTimeoutMs": 120000,
      "exposure": "direct"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "bearerTokenStore": true,
      "exposure": "direct"
    }
  }
}
